<Window x:Class="KlarfViewer.View.ImageProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KlarfViewer.View"
        mc:Ignorable="d"
        Title="Image Processor" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>

        <Image Source="{Binding ProcessedImage}" Grid.Column="0" Margin="10"/>

        <StackPanel Grid.Column="1" Margin="10">
            <TextBlock Text="Brightness"/>
            <Slider Minimum="-255" Maximum="255" Value="{Binding Brightness, Mode=TwoWay}"/>
            <TextBlock Text="Contrast"/>
            <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast, Mode=TwoWay}"/>
            <TextBlock Text="Blur Radius"/>
            <Slider Minimum="0" Maximum="10" Value="{Binding BlurRadius, Mode=TwoWay}"/>

            <Button Content="Apply Changes" Command="{Binding ApplyChangesCommand}" Margin="0,20,0,0"/>
            <Button Content="Show Histogram" Command="{Binding ShowHistogramCommand}" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>