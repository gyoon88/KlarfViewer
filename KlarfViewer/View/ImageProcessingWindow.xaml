<Window x:Class="KlarfViewer.View.ImageProcessingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KlarfViewer.View"
        mc:Ignorable="d"
        Title="Image Processor" Height="450" Width="700">
    <Grid Background="{StaticResource PrimaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="200"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SecondaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    
                </Grid.RowDefinitions>
                <TextBlock Text="Image" Foreground="White" FontSize="14"/>
                <Image Source="{Binding ProcessedImage}" Grid.Row ="1" Margin="10"/>

            </Grid>
        </Border>
        <GridSplitter/>
        <StackPanel Grid.Column="2" Margin="10">



            <TextBlock Text="Brightness" Grid.Column="0" Foreground="White" />

            <Slider Grid.Column="1" Minimum="-255" Maximum="255" Value="{Binding Brightness, Mode=TwoWay}"/>

            <Separator/>

            <TextBlock Text="Contrast" Foreground="White" />
            <Slider Minimum="-100" Maximum="100" Value="{Binding Contrast, Mode=TwoWay}"/>
            <Separator/>

            <TextBlock Text="Blur Radius" Foreground="White" />
            <Slider Minimum="0" Maximum="10" Value="{Binding BlurRadius, Mode=TwoWay}"/>
            <Separator/>

            <Button Content="Apply Changes" Command="{Binding ApplyChangesCommand}" Margin="0,20,0,0"/>
            <Button Content="Show Histogram" Command="{Binding ShowHistogramCommand}" Margin="0,10,0,0"/>
        </StackPanel>
    </Grid>
</Window>